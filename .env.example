# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.socialmediajusticetoday.com
NEXT_PUBLIC_PHONE=

# ─── Typeform (existing client survey — embedded, not rebuilt) ───────────
# Typeform LIVE id (data-tf-live), taken from the client's production embed.
NEXT_PUBLIC_TYPEFORM_LIVE_ID=01KSWKH557QMZ30Y4QRF3VEABM

# ─── Meta / Facebook tracking ────────────────────────────────────────────
# Browser pixel
NEXT_PUBLIC_FB_PIXEL_ID=
# Server-side Conversions API (client's existing infra)
FB_CAPI_ACCESS_TOKEN=
FB_CAPI_DATASET_ID=
# Optional: test event code while validating in Events Manager
FB_CAPI_TEST_EVENT_CODE=

# ─── Analytics ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Imagery ─────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ─── Lead delivery (optional — if we capture before Typeform handoff) ────
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ─── Qualification relay ─────────────────────────────────────────────────
# Where /qualified is allowed to redirect. Comma separated hostnames.
# UNSET MEANS EVERY REDIRECT FALLS BACK TO /thank-you, so the retainer is
# never reached. Set this before pointing any traffic at /qualified.
RETAINER_ALLOWED_HOSTS=
# Fallback destination when `next` is absent or fails the allowlist.
RETAINER_REDIRECT_URL=
# Shared secret for POST /api/qualify, the server-to-server path the client's
# n8n calls to mark an entry_id qualified or retained. Sent as
# `Authorization: Bearer <secret>`.
QUALIFY_WEBHOOK_SECRET=

# ─── Match data store (Upstash Redis via Vercel Marketplace) ─────────────
# At Lead time we hold fbc/fbp/email/phone. Meta needs them again on the
# later Qualified/Retained event to attribute it back to an ad, but that
# event arrives from n8n hours or days later with only the entry_id. These
# park the match data against the entry_id in between. Unset is safe: the
# store no-ops and Qualified still fires, just without match data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# How long to keep match data. Meta's click window is 7 days; 30 gives room
# for a slow qualification without hoarding PII.
LEAD_MATCH_TTL_DAYS=30

# ─── Compliance ──────────────────────────────────────────────────────────
TRUSTEDFORM_SCRIPT=

# ─── Growth Channel (programmatic DSP) ───────────────────────────────────
# Retargeting — injected on every page.
NEXT_PUBLIC_GC_RETARGETING_PIXEL=https://pxl.growth-channel.net/s/b53440a4-6741-4bd0-b6a3-e938b7015716
# Conversion — fires ONLY on the optimized event (completed intake form).
NEXT_PUBLIC_GC_CONVERSION_PIXEL=https://pxl.growth-channel.net/s/cd2e042a-933c-4526-9cfe-5946b95e5671

# ─── Google Tag Manager ──────────────────────────────────────────────────
# Optional. If a tag is managed in GTM, unset its env var above or it fires twice.
NEXT_PUBLIC_GTM_ID=
